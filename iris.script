    ;do $System.OBJ.LoadDir("/home/irisowner/dev/src","ck",,1)

    ;disabling password expire for development purposes
    zn "%SYS"
    Do ##class(Security.Users).UnExpireUserPasswords("*")

    ; enabling callin for Embedded Python
    do ##class(Security.Services).Get("%Service_CallIn",.prop)
    set prop("Enabled")=1
    set prop("AutheEnabled")=48
    do ##class(Security.Services).Modify("%Service_CallIn",.prop)

    ; pyprod: install intersystems-pyprod in a virtual environment
    set venv="/home/irisowner/pyprod-venv"
    set sitepkg=venv_"/lib/python3.12/site-packages"
    set sc=$ZF(-100,"/SHELL","python3","-m","venv",venv)
    write "venv exit code: ",sc,!
    set sc=$ZF(-100,"/SHELL",venv_"/bin/pip","install","intersystems-pyprod")
    write "pip install intersystems-pyprod exit code: ",sc,!
    ; make the venv visible to embedded Python (used at runtime by the generated classes)
    zn "%SYS"
    set p("PythonPath")=sitepkg
    set sc=##class(Config.config).Modify(.p)
    write "PythonPath set status: ",sc,!
    ; generate and load the Python Business Service / Process / Production classes.
    ; irispython does not read PythonPath, so the venv is put on sys.path before calling the intersystems_pyprod entry point (_parser:main)
    set env="IRISINSTALLDIR=/usr/irissys IRISUSERNAME=_SYSTEM IRISPASSWORD=SYS IRISNAMESPACE=USER"
    set cmd="import sys; sys.path.insert(0,"""_sitepkg_"""); from intersystems_pyprod._parser import main; main()"
    set sc=$ZF(-100,"/SHELL","env",$piece(env," ",1),$piece(env," ",2),$piece(env," ",3),$piece(env," ",4),"irispython","-c",cmd,"/home/irisowner/dev/python/creditrisk_pyprod.py")
    write "pyprod load exit code: ",sc,!

    zpm "install passwordless"
    zpm "install csvgen"
    ; importing the source code of the repository as ZPM module
    zn "USER"
    zpm "load /home/irisowner/dev -v":1:1

    halt
